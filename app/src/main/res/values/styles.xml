<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="PlayerTheme" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
